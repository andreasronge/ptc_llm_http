#!/usr/bin/env bash

# Deterministic push gate.
#
# Runs the same repository-owned scripts as GitHub Actions, but only the fast
# deterministic ones. Dialyzer, the Elixir/OTP compatibility matrix, and the
# release/package jobs are left to CI on purpose: this project exists to keep
# a per-change loop short, and a local gate that costs minutes would recreate
# the problem it was extracted to solve.
#
# Run `mix full_check` yourself before tagging a release, and never release on
# anything but a complete CI result.
#
# Bypass with `git push --no-verify` only when pushing documentation you have
# already gated another way.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

exec scripts/ci/check.sh
