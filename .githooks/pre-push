#!/usr/bin/env bash

# Complete local push gate.
#
# Runs every gate that is meaningful on the local toolchain before updating a
# remote branch. GitHub Actions still supplies the separate OS and Elixir/OTP
# matrix environments that a single workstation cannot reproduce.
#
# Bypass with `git push --no-verify` only when pushing documentation you have
# already gated another way.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

exec scripts/ci/full_check.sh
